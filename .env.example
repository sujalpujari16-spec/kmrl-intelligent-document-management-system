# ============================================================================
# KMRL Intelligent Document Management System (IDMS) - Enterprise Environment Config
# ============================================================================

# 1. Supabase PostgreSQL & Private Storage Configuration (Required - Zero Local DB Fallback)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 2. Google Gemini API (Required for text-embedding-004 pgvector RAG & Multimodal Vision OCR)
GEMINI_API_KEY="your_gemini_api_key_here"

# 3. Cloudflare Turnstile Bot Protection (Optional in development/test, required in production)
TURNSTILE_SITE_KEY="your_turnstile_site_key_here"
TURNSTILE_SECRET_KEY="your_turnstile_secret_key_here"

# 4. Security & CORS Origin Configuration
APP_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://kmrl-idms.in"
TRUST_PROXY="1"

# 5. App Server Configuration
PORT=3000
NODE_ENV="development"
